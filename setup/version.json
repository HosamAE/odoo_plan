{
  "_comment": "What Odoo 19 needs on a machine. `odoo-ai setup` reads this; change it here, not on one machine.",
  "version": "19",
  "odoo_branch": "19.0",
  "python": "3.12",
  "repos": [
    {"path": "odoo", "url": "https://github.com/odoo/odoo.git", "branch": "19.0", "required": true},
    {"path": "design-themes", "url": "https://github.com/odoo/design-themes.git", "branch": "19.0", "required": false},
    {"path": "enterprise", "url": "https://github.com/odoo/enterprise.git", "branch": "19.0", "required": false,
     "note": "needs an Odoo partner account with access to odoo/enterprise; skipped when the clone is refused"}
  ],
  "pip_extra": [
    "pyyaml", "pyflakes", "black", "flake8", "pylint-odoo==10.0.4", "isort",
    "openpyxl", "ofxparse", "xlsxwriter", "qrcode", "cryptography", "phonenumbers", "websocket-client",
    "CairoSVG", "pymupdf", "gTTS", "paramiko", "python-crontab", "SQLAlchemy", "pre_commit", "playwright"
  ],
  "addons_path": ["enterprise", "design-themes", "odoo/addons", "third-party"],
  "db_user": "odoo19",
  "postgresql": "16 or newer (18 used here); db_template = template1 on Windows with PostgreSQL 18",
  "wkhtmltopdf": "0.12.6 (patched Qt), C:/Program Files/wkhtmltopdf/bin",
  "pylint_plugin": true
}
