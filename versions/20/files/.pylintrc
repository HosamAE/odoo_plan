[MASTER]
# A comma-separated list of package or module names from where C extensions may
# be loaded. Extensions are loading into the active Python interpreter and may
# run arbitrary code.
extension-pkg-whitelist=

# Odoo's addons namespace is populated at RUNTIME (odoo.addons.__path__.append
# per addons_path entry - see odoo/modules/module.py:initialize_sys_path), not
# a static filesystem layout astroid can resolve on its own, even with the
# init-hook (Acme.code-workspace) recreating that same runtime step for
# pylint's own process. Silences E0401/E0611 on every
# `from odoo.addons.<module>...` cross-addon import project-wide.
ignored-modules=odoo.addons

# Add files or directories to the blacklist. They should be base names, not paths.
ignore=CVS,.git,venv,enterprise,design-themes,third-party

# Make the local plugins importable for every caller (VS Code and odoo-ai lint).
init-hook="import sys; sys.path[:0] = ['C:/odoo/odoo20/tools/pylint_plugins', 'C:/odoo/odoo20/odoo']"

# Load plugins if they are available. odoo_namespace: see pylint_plugins/odoo_namespace.py
load-plugins=pylint_odoo,odoo_namespace

[MESSAGES CONTROL]
# Disable the messages which are not relevant or too noisy for Odoo
disable=
    # General Python/Pylint style checks that are too noisy in Odoo
    no-member,
    E1101,
    missing-docstring,
    too-few-public-methods,
    duplicate-code,
    import-outside-toplevel,
    protected-access,
    too-many-ancestors,
    attribute-defined-outside-init,
    invalid-name,
    # Swedish identifiers (väg, otillfrågade) are a deliberate project convention.
    non-ascii-name,
    unused-argument,
    abstract-method,

    # OCA specific manifest/layout checks (not required for proprietary/custom modules)
    manifest-required-author,
    manifest-required-key,
    manifest-deprecated-key,
    manifest-maintainers-list,
    license-allowed,
    manifest-version-format,
    translation-required,
    development-status-allowed,
    missing-readme,
    no-wizard-in-models,
    category-allowed,
    missing-odoo-file,
    manifest-superfluous-key,
    category-allowed-app,
    missing-odoo-file-app,
    manifest-required-key-app,
    manifest-summary-multiline,
    manifest-author-string,
    website-manifest-key-not-valid-uri,
    manifest-external-assets,
    
    # Custom Odoo design rules that are often preferred to be ignored
    attribute-string-redundant,
    method-compute,
    method-search,
    method-inverse

[REPORTS]
output-format=text

[FORMAT]
# Maximum number of characters on a single line.
max-line-length=120

[ODOOLINT]
# Target Odoo version
valid-odoo-versions=20.0

