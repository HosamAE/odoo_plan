{
  "name": "odoo-ci",
  "displayName": "Cockpit Odoo",
  "description": "Run, test and inspect your Odoo projects (17-20) from one panel: servers, databases, errors linked to your code, and the dependency map of the module you are editing.",
  "publisher": "HosamAE",
  "author": {
    "name": "HosamAE",
    "url": "https://github.com/HosamAE"
  },
  "homepage": "https://github.com/HosamAE/odoo_plan",
  "repository": {
    "type": "git",
    "url": "https://github.com/HosamAE/odoo_plan.git"
  },
  "icon": "media/icon.png",
  "version": "2.4.6",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "odoo",
    "odoo19",
    "odoo18",
    "odoo17",
    "odoo20",
    "ci",
    "testing",
    "xpath",
    "i18n",
    "studio",
    "knowledge-graph",
    "dependencies"
  ],
  "activationEvents": [
    "workspaceContains:**/__manifest__.py",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Cockpit Odoo runs the project's Python, scripts and CI checks, and the tools in it. Trust the folder first."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "odooCi.cockpit",
        "title": "Open Cockpit Odoo in the Editor",
        "category": "Odoo Studio",
        "icon": "$(dashboard)"
      },
      {
        "command": "odooCi.serverRun",
        "title": "Start Odoo Server",
        "category": "Odoo Studio",
        "icon": "$(play)"
      },
      {
        "command": "odooCi.serverRunQuick",
        "title": "Start Odoo Server (as the .conf says, no questions)",
        "category": "Odoo Studio",
        "icon": "$(play)"
      },
      {
        "command": "odooCi.serverStop",
        "title": "Stop Odoo Server",
        "category": "Odoo Studio",
        "icon": "$(stop-circle)"
      },
      {
        "command": "odooCi.serverRestart",
        "title": "Restart Odoo Server",
        "category": "Odoo Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "odooCi.serverOpen",
        "title": "Open Server in Browser",
        "category": "Odoo Studio",
        "icon": "$(globe)"
      },
      {
        "command": "odooCi.serverUpgrade",
        "title": "Upgrade Modules (all or chosen) on a Database",
        "category": "Odoo Studio",
        "icon": "$(sync)"
      },
      {
        "command": "odooCi.serverDrift",
        "title": "Check a Database Against the Code",
        "category": "Odoo Studio",
        "icon": "$(diff)"
      },
      {
        "command": "odooCi.serverHealth",
        "title": "Show Server Health",
        "category": "Odoo Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "odooCi.static",
        "title": "Run static checks",
        "category": "Odoo CI",
        "icon": "$(checklist)"
      },
      {
        "command": "odooCi.fastTest",
        "title": "Fast DB Test (Template DB)",
        "category": "Odoo Studio",
        "icon": "$(zap)"
      },
      {
        "command": "odooCi.full",
        "title": "Run full CI (install and test)",
        "category": "Odoo CI",
        "icon": "$(beaker)"
      },
      {
        "command": "odooCi.fullStop",
        "title": "Run full CI, stopping running Odoo servers first",
        "category": "Odoo CI"
      },
      {
        "command": "odooCi.xpathCheck",
        "title": "Validate XML Views & XPath",
        "category": "Odoo Studio",
        "icon": "$(check)"
      },
      {
        "command": "odooCi.dbSnapSave",
        "title": "Take Instant DB Snapshot",
        "category": "Odoo Studio",
        "icon": "$(device-camera)"
      },
      {
        "command": "odooCi.dbSnapRestore",
        "title": "Restore DB from Snapshot",
        "category": "Odoo Studio",
        "icon": "$(history)"
      },
      {
        "command": "odooCi.i18nScan",
        "title": "Scan Module Translations (i18n)",
        "category": "Odoo Studio",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "odooCi.newAddon",
        "title": "Scaffold New Compliant Addon",
        "category": "Odoo Studio",
        "icon": "$(add)"
      },
      {
        "command": "odooCi.doctor",
        "title": "Run Odoo-AI Doctor Check",
        "category": "Odoo Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "odooCi.audit",
        "title": "Audit Security CSV & Manifest of This Module",
        "category": "Odoo Studio",
        "icon": "$(shield)"
      },
      {
        "command": "odooCi.openGuide",
        "title": "Open the Cockpit Odoo Guide",
        "category": "Odoo Studio",
        "icon": "$(book)"
      },
      {
        "command": "odooCi.setupWizard",
        "title": "Quick Project Setup Wizard",
        "category": "Odoo Studio",
        "icon": "$(gear)"
      },
      {
        "command": "odooCi.initFastDb",
        "title": "Initialize Fast Template DB",
        "category": "Odoo Studio",
        "icon": "$(database)"
      },
      {
        "command": "odooCi.cancel",
        "title": "Cancel the running check",
        "category": "Odoo CI",
        "icon": "$(debug-stop)"
      },
      {
        "command": "odooCi.menu",
        "title": "Cockpit Odoo Menu",
        "category": "Odoo Studio"
      },
      {
        "command": "odooCi.showOutput",
        "title": "Show Odoo CI Output",
        "category": "Odoo CI",
        "icon": "$(output)"
      },
      {
        "command": "odooCi.openLog",
        "title": "Open Odoo Test Log",
        "category": "Odoo CI",
        "icon": "$(file-text)"
      },
      {
        "command": "odooCi.refresh",
        "title": "Refresh Studio Status",
        "category": "Odoo Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "odooCi.newVersion",
        "title": "Set up an Odoo Version",
        "category": "Odoo Studio",
        "icon": "$(rocket)"
      },
      {
        "command": "odooCi.selfTest",
        "title": "Tools CI (before push)",
        "category": "Odoo Studio",
        "icon": "$(beaker)"
      },
      {
        "command": "odooCi.syncVersions",
        "title": "Version Branches vs main",
        "category": "Odoo Studio",
        "icon": "$(git-compare)"
      },
      {
        "command": "odooCi.secretScan",
        "title": "Scan Staged Files for Secrets",
        "category": "Odoo Studio",
        "icon": "$(shield)"
      },
      {
        "command": "odooCi.secretHook",
        "title": "Install Secret Pre-commit Hook",
        "category": "Odoo Studio",
        "icon": "$(lock)"
      },
      {
        "command": "odooCi.gates",
        "title": "Project Gates (Odoo Rules)",
        "category": "Odoo Studio",
        "icon": "$(law)"
      },
      {
        "command": "odooCi.openLayout",
        "title": "Open the Layout Guide",
        "category": "Odoo Studio",
        "icon": "$(book)"
      },
      {
        "command": "odooCi.refreshEnv",
        "title": "Refresh Versions",
        "category": "Odoo Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "odooCi.issueOpen",
        "title": "Open Error or Warning",
        "category": "Odoo Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "odooCi.issueOpenLog",
        "title": "Open the Log at This Line",
        "category": "Odoo Studio",
        "icon": "$(output)"
      },
      {
        "command": "odooCi.issueOpenSource",
        "title": "Open the Code Behind This",
        "category": "Odoo Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "odooCi.issueNext",
        "title": "Go to Next Error or Warning",
        "category": "Odoo Studio",
        "icon": "$(arrow-down)"
      },
      {
        "command": "odooCi.issuePrev",
        "title": "Go to Previous Error or Warning",
        "category": "Odoo Studio",
        "icon": "$(arrow-up)"
      },
      {
        "command": "odooCi.issuePick",
        "title": "Pick an Error or Warning...",
        "category": "Odoo Studio",
        "icon": "$(search)"
      },
      {
        "command": "odooCi.issueFilter",
        "title": "Filter Errors and Warnings...",
        "category": "Odoo Studio",
        "icon": "$(filter)"
      },
      {
        "command": "odooCi.openServerLog",
        "title": "Open the Server Log (errors red, warnings yellow)",
        "category": "Odoo Studio",
        "icon": "$(output)"
      },
      {
        "command": "odooCi.issueShow",
        "title": "Show Errors and Warnings",
        "category": "Odoo Studio",
        "icon": "$(list-flat)"
      },
      {
        "command": "odooCi.cockpitPanel",
        "title": "Open Cockpit Odoo in the Bottom Panel",
        "category": "Odoo Studio",
        "icon": "$(dashboard)"
      },
      {
        "command": "odooCi.graphModule",
        "title": "Show the Graph of This Module",
        "category": "Odoo Studio",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "odooCi.graphUpdate",
        "title": "Update the Project Graph",
        "category": "Odoo Studio",
        "icon": "$(sync)"
      },
      {
        "command": "odooCi.cockpitTab",
        "title": "Open a Page of the Cockpit Odoo",
        "category": "Odoo Studio",
        "icon": "$(dashboard)"
      },
      {
        "command": "odooCi.translations",
        "title": "Translations: Open the Translations Page",
        "category": "Odoo Studio",
        "icon": "$(globe)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "odooStudio",
          "title": "Cockpit Odoo",
          "icon": "media/studio.svg"
        }
      ],
      "panel": [
        {
          "id": "odooCockpit",
          "title": "Cockpit Odoo",
          "icon": "media/studio.svg"
        }
      ]
    },
    "views": {
      "odooStudio": [
        {
          "id": "odooCi.env",
          "name": "This Odoo Version"
        },
        {
          "id": "odooCi.actions",
          "name": "Project Control Panel"
        },
        {
          "id": "odooCi.issues",
          "name": "Errors & Warnings"
        }
      ],
      "odooCockpit": [
        {
          "type": "webview",
          "id": "odooCi.cockpitView",
          "name": "Cockpit"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "odooCi.env",
        "contents": "The Odoo version of this project.\n[$(rocket) Set up an Odoo version](command:odooCi.newVersion)\n[$(pulse) Doctor](command:odooCi.doctor)"
      },
      {
        "view": "odooCi.actions",
        "contents": "Cockpit Odoo by HosamAE:\n[$(gear) Setup Wizard](command:odooCi.setupWizard)\n[$(play) Start Server](command:odooCi.serverRunQuick)\n[$(globe) Open Browser](command:odooCi.serverOpen)\n[$(zap) Fast Test](command:odooCi.fastTest)\n[$(camera) DB Snapshot](command:odooCi.dbSnapSave)\n[$(checklist) Static Checks](command:odooCi.static)\n[$(beaker) Full CI Suite](command:odooCi.full)\n[$(add) New Addon](command:odooCi.newAddon)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "odooCi.refresh",
          "when": "view == odooCi.actions",
          "group": "navigation@1"
        },
        {
          "command": "odooCi.static",
          "when": "view == odooCi.actions && !odooCi.running",
          "group": "navigation@2"
        },
        {
          "command": "odooCi.full",
          "when": "view == odooCi.actions && !odooCi.running",
          "group": "navigation@3"
        },
        {
          "command": "odooCi.cancel",
          "when": "view == odooCi.actions && odooCi.running",
          "group": "navigation@4"
        },
        {
          "command": "odooCi.showOutput",
          "when": "view == odooCi.actions",
          "group": "navigation@5"
        },
        {
          "command": "odooCi.refreshEnv",
          "when": "view == odooCi.env",
          "group": "navigation@1"
        },
        {
          "command": "odooCi.newVersion",
          "when": "view == odooCi.env",
          "group": "navigation@2"
        },
        {
          "command": "odooCi.issuePrev",
          "when": "view == odooCi.issues",
          "group": "navigation@1"
        },
        {
          "command": "odooCi.issueNext",
          "when": "view == odooCi.issues",
          "group": "navigation@2"
        },
        {
          "command": "odooCi.issuePick",
          "when": "view == odooCi.issues",
          "group": "navigation@3"
        },
        {
          "command": "odooCi.issueFilter",
          "when": "view == odooCi.issues",
          "group": "navigation@4"
        },
        {
          "command": "odooCi.openServerLog",
          "when": "view == odooCi.issues",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "odooCi.issueOpenLog",
          "when": "view == odooCi.issues && viewItem =~ /^issue/",
          "group": "inline@1"
        },
        {
          "command": "odooCi.issueOpenSource",
          "when": "view == odooCi.issues && viewItem == issueWithSource",
          "group": "inline@2"
        },
        {
          "command": "odooCi.serverStop",
          "when": "view == odooCi.actions && viewItem == server-running",
          "group": "inline@1"
        },
        {
          "command": "odooCi.serverRestart",
          "when": "view == odooCi.actions && viewItem == server-running",
          "group": "inline@2"
        },
        {
          "command": "odooCi.serverOpen",
          "when": "view == odooCi.actions && viewItem == server-running",
          "group": "inline@3"
        },
        {
          "command": "odooCi.serverRunQuick",
          "when": "view == odooCi.actions && viewItem == server-stopped",
          "group": "inline@1"
        },
        {
          "command": "odooCi.static",
          "when": "view == odooCi.actions && viewItem == quality && !odooCi.running",
          "group": "inline@1"
        },
        {
          "command": "odooCi.graphUpdate",
          "when": "view == odooCi.actions && viewItem == graph",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "odooCi.cockpitTab",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "odooCi.translations",
          "when": "workspaceFolderCount > 0",
          "group": "7_modification@9"
        }
      ]
    },
    "configuration": {
      "title": "Odoo CI",
      "properties": {
        "odooCi.python": {
          "type": "string",
          "default": "",
          "description": "Python executable that runs odoo-ai. Empty defaults to C:\\odoo\\odoo<NN>\\venv\\Scripts\\python.exe."
        },
        "odooCi.cliPath": {
          "type": "string",
          "default": "",
          "description": "CLI script to run. Empty defaults to C:\\odoo\\odoo<NN>\\tools\\cli.py."
        },
        "odooCi.defaultLang": {
          "type": "string",
          "default": "",
          "description": "Default language code for i18n translation scanning and sync (e.g. 'sv', 'ar', 'de', 'fr')."
        },
        "odooCi.version": {
          "type": "string",
          "default": "",
          "description": "Target Odoo major version ('17', '18', '19', '20'). Default auto-detects from workspace."
        },
        "odooCi.serverPort": {
          "type": "number",
          "default": 0,
          "description": "Odoo server HTTP port for this project (e.g. 1900, 8069). 0 auto-detects from .conf file."
        },
        "odooCi.odooRoot": {
          "type": "string",
          "default": "",
          "description": "The Odoo workspace root (the folder holding odoo17..odoo20 and bin). Empty: ODOO_ROOT, else found from the open project."
        },
        "odooCi.backupDir": {
          "type": "string",
          "default": "",
          "description": "Where database backups go. Empty: a 'backups' folder in the Odoo root."
        },
        "odooCi.backupBeforeUpgrade": {
          "type": "boolean",
          "default": false,
          "description": "Back a database up before upgrading it, and stop if the backup fails."
        },
        "odooCi.maintainerTools": {
          "type": "boolean",
          "default": false,
          "description": "Show the commands for people who maintain these tools themselves (run the tools' own CI, compare the 17/18/19/20 branches with main). Off for everyone else."
        },
        "odooCi.graph.keepGenerations": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Knowledge graph: every update leaves a new generation (tens of MB) that the engine never removes. 0 keeps them all (nothing is deleted). A number keeps the published one and that many of the newest, and removes the rest after each update."
        },
        "odooCi.graph.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Knowledge graph: when the project opens and its graph is behind the code, update it quietly in the background (no pop-up). Turn off to update it only with the Update button of the Graph page."
        },
        "odooCi.graph.followEditor": {
          "type": "boolean",
          "default": true,
          "description": "Knowledge graph: the Graph page draws the whole dependency tree of the module of the file you are editing, and follows you from file to file. Pressing a module on the map pins it until you tick 'Follow the file I'm editing' again."
        },
        "odooCi.remoteSudoUser": {
          "type": "string",
          "default": "",
          "description": "Remote servers: the one account a host opens to you for its databases and files (for example odoo19_demo), when it refuses sudo as postgres. Empty: postgres, with root for files."
        },
        "odooCi.i18n.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "sv_SE"
          ],
          "description": "Translations: the languages the page always lists for a module, even before they have a .po file (for example sv_SE, ar)."
        },
        "odooCi.i18n.translatorUrl": {
          "type": "string",
          "default": "",
          "description": "Translations: the base URL of a model of your own, OpenAI-compatible (a local Ollama is http://localhost:11434/v1 and costs nothing). Empty: no automatic translation. A host that is not on this machine is asked about once, because the untranslated terms are sent there."
        },
        "odooCi.i18n.translatorModel": {
          "type": "string",
          "default": "",
          "description": "Translations: the model's name at that URL (for example qwen2.5:7b)."
        }
      }
    }
  }
}
